# Copy to `.env.local` for local dev. For production (Vercel), set the same `VITE_*` names
# in Project → Settings → Environment Variables, or rely on `vercel.json` → `build.env` where configured.

# Supabase (required)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# GIPHY Web SDK (event chat GIF picker). https://developers.giphy.com/
VITE_GIPHY_API_KEY=

# RevenueCat (optional — in-app purchases)
# VITE_REVENUECAT_PUBLIC_KEY=
