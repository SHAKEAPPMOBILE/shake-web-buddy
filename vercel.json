{
  "routes": [
    {
      "src": "/invite/(.*)",
      "has": [{"type": "header", "key": "user-agent", "value": "(?i).*(whatsapp|facebookexternalhit|twitterbot|linkedinbot|telegrambot|slackbot).*"}],
      "dest": "/api/share/$1"
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
